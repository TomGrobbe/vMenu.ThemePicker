<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!--
      The client half of the vMenu plugin API. Its version always matches the vMenu Enhanced
      release it belongs to, so pin it to the vMenu version your server actually runs and raise
      it when you update vMenu. Pinned rather than floating: a plugin that silently follows the
      newest package is a plugin that breaks on a vMenu release nobody tested it against.

      0.0.1-alpha.92 is the first release whose API can list and set themes.
    -->
    <PackageVersion Include="vMenu.Enhanced.ClientAPI" Version="0.0.1-alpha.92" />
  </ItemGroup>
</Project>
